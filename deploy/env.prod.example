# Copy to deploy/.env.prod (git-ignored) and fill in. Nothing here has a usable default:
# the stack refuses to start until every required value is set.
#
# Generate secrets with:
#   openssl rand -base64 48     # JWT_SECRET, JWT_REFRESH_SECRET (must differ)
#   openssl rand -base64 32     # GOOGLE_HEALTH_TOKEN_KEY, POSTGRES_PASSWORD, REDIS_PASSWORD

# --- Required -----------------------------------------------------------------

# Public hostname, without scheme. DNS must point at this host before first start,
# or the certificate cannot be issued.
DOMAIN=

POSTGRES_PASSWORD=
REDIS_PASSWORD=

JWT_SECRET=
JWT_REFRESH_SECRET=

# Encrypts stored Google OAuth tokens AND users' DeepSeek API keys. Required even if
# neither integration is used. Changing it later makes existing stored keys unreadable.
GOOGLE_HEALTH_TOKEN_KEY=

# --- Email (password reset, email verification) -------------------------------
# Any SMTP provider. Without email a user who forgets their password cannot recover
# the account; to run that way anyway, set MAIL_ENABLED=false and SMTP_HOST=unused.
MAIL_ENABLED=true
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Optional -----------------------------------------------------------------

# Image tag to build/run. Bump on each release so a rollback has something to go back to.
APP_VERSION=1.0.0
APP_MEMORY_LIMIT=1g

# AI features. Off by default.
#   deepseek: each user supplies their own key; their workout notes are sent to DeepSeek.
#   ollama:   local model; also start with --profile ollama and set OLLAMA_ENABLED=true.
AI_PROVIDER=ollama
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:7b

# Google Health (Fitbit) import. Needs an OAuth client whose redirect URI is
# https://<DOMAIN>/api/v1/integrations/google-health/callback
GOOGLE_HEALTH_ENABLED=false
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
